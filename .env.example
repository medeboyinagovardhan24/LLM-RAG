# =========================================================
# LLM-Powered Domain-Specific QA System — environment config
# ---------------------------------------------------------
# Copy this file to .env and fill in your values:
#     cp .env.example .env
# The .env file is git-ignored and must never be committed.
# =========================================================

# REQUIRED — your Google Gemini API key.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used for answer generation.
# Use a currently supported model name; gemini-2.0-flash was retired by Google.
GEMINI_MODEL=gemini-3.6-flash

# --- RAG parameters (optional; defaults shown) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- CORS: comma-separated browser origins allowed to call the API ---
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# --- Storage: base directory holding chroma_db/ and uploads/ ---
# Leave unset for local dev (defaults to the repo root).
# Docker sets this to /data automatically.
# DATA_DIR=.
